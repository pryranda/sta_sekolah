name: sekolah_app
description: "A new Flutter project."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '^3.12.2'
  
dependencies:
  flutter:
    sdk: flutter
  http: ^1.1.0
  shared_preferences: ^2.2.2
  # ❌ HAPUS: geolocator_web: ^2.2.0  (sudah otomatis di-handle oleh geolocator)
  flutter_map: 5.0.0
  latlong2: 0.9.0
  provider: ^6.1.1
  jwt_decoder: ^2.0.1
  fluttertoast: ^9.1.0 
  cupertino_icons: ^1.0.6
  geolocator: ^11.0.0  # ✅ Ini sudah include web support
  intl: ^0.19.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true